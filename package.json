{
  "name": "recherche-job",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @rj/web dev",
    "dev:worker": "pnpm --filter @rj/worker dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "scrape": "pnpm --filter @rj/worker scrape",
    "test": "pnpm -r test"
  }
}
